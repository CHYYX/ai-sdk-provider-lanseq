{
  "name": "@lanseq/ai-sdk-provider",
  "version": "0.1.0",
  "description": "Official Lanseq provider for the Vercel AI SDK",
  "keywords": [
    "ai",
    "ai-sdk",
    "lanseq",
    "llm",
    "inference",
    "openai-compatible",
    "agents",
    "vercel"
  ],
  "author": "Lanseq",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run type-check && npm test && npm run build && npm pack --dry-run",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.53"
  },
  "peerDependencies": {
    "ai": "^7.0.107",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "ai": "^7.0.107",
    "tsup": "^8.5.1",
    "typescript": "5.8.3",
    "vitest": "4.0.18",
    "zod": "3.25.76",
    "@types/node": "22.19.19"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lanseqcloud/ai-sdk-provider-lanseq.git"
  },
  "bugs": {
    "url": "https://github.com/Lanseqcloud/ai-sdk-provider-lanseq/issues"
  },
  "homepage": "https://lanseq.cloud"
}
